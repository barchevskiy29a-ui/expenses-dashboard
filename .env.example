# Google Sheets spreadsheet id: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Path to the service account JSON key downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# Alternative: the raw service account JSON as a single-line string
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
